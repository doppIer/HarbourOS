# Tailscale IP of the server (port is bound only there)
TAILSCALE_IP=100.64.0.7

# Optional. Leave empty and the first visit shows "Set up HarbourOS", where you
# create the admin account. If set, an admin is created on first boot with:
HARBOR_ADMIN_EMAIL=
HARBOR_PASSWORD=
# Signs session cookies. Leave it empty and HarbourOS makes a random one in
# data/session.secret on first start. If you set it, use 32+ random characters
# (for example: openssl rand -hex 32).
SESSION_SECRET=

# Sign in with your Tailscale identity when served via `tailscale serve` (1 = on).
# Headers are only believed from the local Tailscale Serve proxy, never from a
# client connecting straight to the port.
TRUST_TAILSCALE_HEADERS=0
# Comma-separated tailnet logins allowed when header auth is on.
# Each login must match the email of an active HarbourOS account.
TAILSCALE_ALLOWED_USERS=you@example.com

# Claude (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# User on the host that the terminal SSHes into (see host/setup-terminal.sh)
TERMINAL_SSH_USER=harbor
